# 배포(prod 프로필)용 환경변수 예시. 실제 값이 담긴 .env 는 절대 커밋하지 말 것.
# Cloud Run 에서는 이 값들을 "변수 및 보안 비밀" 탭 또는 --set-env-vars 로 넣는다.

# 예) Cloud SQL 퍼블릭 IP / Neon / Supabase
DB_URL=jdbc:postgresql://HOST:5432/chungwoon
DB_USERNAME=chungwoon
DB_PASSWORD=change-me

# 예) Cloud SQL 커넥터(소켓 팩토리)로 붙일 때
#     - build.gradle 에 com.google.cloud.sql:postgres-socket-factory 의존성이 필요하다. DEPLOY.md 참고.
# DB_URL=jdbc:postgresql:///chungwoon?cloudSqlInstance=PROJECT:REGION:INSTANCE&socketFactory=com.google.cloud.sql.postgres.SocketFactory
